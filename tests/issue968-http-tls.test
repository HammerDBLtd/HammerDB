# Regression checks for TPC-Council/HammerDB#968.
# Run from the repository root: tclsh tests/issue968-http-tls.test
package require Tcl 8.6
package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root modules wapp-1.1.tm]

# Minimal page handler; no HammerDB database or Web Service startup required.
proc wapp-default {} {wapp {HTTP test OK}}

proc issue968_read {sock} {
  if {[catch {read $sock} data]} {
    set ::issue968_done closed
    return
  }
  append ::issue968_response $data
  if {[eof $sock]} {set ::issue968_done closed}
}

proc issue968_request {payload} {
  set listener [socket -server [list wappInt-new-connection \
      wappInt-http-readable server {}] -myaddr 127.0.0.1 0]
  set port [lindex [fconfigure $listener -sockname] 2]
  set client [socket 127.0.0.1 $port]
  fconfigure $client -blocking 0 -translation binary -buffering none
  set ::issue968_response {}
  set ::issue968_done pending
  fileevent $client readable [list issue968_read $client]
  set timer [after 2000 {set ::issue968_done timeout}]
  try {
    puts -nonewline $client $payload
    flush $client
    vwait ::issue968_done
    return [list $::issue968_done $::issue968_response]
  } finally {
    after cancel $timer
    catch {close $client}
    catch {close $listener}
  }
}

test issue968-tls-clienthello-1.0 {TLS ClientHello is quietly disconnected} -body {
  issue968_request [binary format H* 160301002e0100002a0303]
} -result {closed {}}

test issue968-legacy-sslv2-1.0 {SSLv2-framed handshake is quietly disconnected} -body {
  issue968_request [binary format H* 8003010002]
} -result {closed {}}

test issue968-http-get-1.0 {ordinary HTTP GET still works} -body {
  lassign [issue968_request "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n"] state response
  list $state [string match "HTTP/1.1 200*" $response] \
      [expr {[string first "HTTP test OK" $response]>=0}]
} -result {closed 1 1}

cleanupTests
