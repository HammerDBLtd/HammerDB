# Existing source-build request semantics must remain unchanged by the wizard.
package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
::tcl::tm::path add [file join $root modules]
package require json
package require pipelines

test pipelines-1.1 {portable source references remain accepted} -body {
    lmap ref {REL_18_1 refs/tags/mysql-9.0 refs/heads/feature/test abc123def} {
        pipelines::__valid_ref $ref
    }
} -result {1 1 1 1}

test pipelines-1.2 {source reference injection remains rejected} -body {
    lmap ref {{-main} {main;exec touch file} {$env(TOKEN)} {a..b} {a//b} {a/.hidden} {a.lock} {main@{1}}} {
        pipelines::__valid_ref $ref
    }
} -result {0 0 0 0 0 0 0 0}

foreach {ui workload pipeline} {single C single_c single H single_h profile C profile compare C compare} {
    test pipelines-1.3-$pipeline {existing pipeline JSON remains compatible} -body {
        set actual [json::json2dict [pipelines::__make_payload_json REL_18_1 pg $ui $workload 1]]
        list [dict get $actual ref] [dict get $actual database] \
            [dict get $actual pipeline] [dict get $actual workload] [dict get $actual io_intensive]
    } -result [list refs/tags/REL_18_1 pg $pipeline $workload 1]
}

test pipelines-1.4 {source commit SHA is not rewritten to a tag} -body {
    dict get [json::json2dict [pipelines::__make_payload_json abcdef01234 maria single C 0]] ref
} -result abcdef01234

test pipelines-1.5 {wizard asset and metadata routes register at module load} -body {
    lmap name {pipeline-wizard-config pipeline-wizard.js pipeline-wizard.css} {
        expr {[llength [info commands ::wapp-page-$name]] == 1}
    }
} -result {1 1 1}

set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
