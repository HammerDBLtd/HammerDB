# Run: tclsh9.0 tests/wizardconfig.test (with the normal HammerDB runtime).
package require Tcl 9.0
package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
::tcl::tm::path add [file join $root modules]
package require xml
package require json
package require wizardconfig

proc load_fixture {} {
    global dbdict genericdict root
    set dbdict [::XML::To_Dict [file join $root config database.xml]]
    set genericdict [::XML::To_Dict [file join $root config generic.xml]]
    foreach key [dict keys $dbdict] {
        set ::config$key [::XML::To_Dict [file join $root config $key.xml]]
    }
}
proc database {metadata id} {
    foreach db [dict get $metadata databases] {
        if {[dict get $db id] eq $id} {return $db}
    }
    error "Missing database $id"
}
proc field_by_name {fields name} {
    foreach field $fields {
        if {[dict get $field name] eq $name} {return $field}
    }
    error "Missing field $name"
}

# Unit tests use real configuration and mock only library installation status.
rename ::wizardconfig::library_status ::wizardconfig::native_library_status
proc ::wizardconfig::library_status {specification} {return available}
rename ::wizardconfig::odbc_drivers ::wizardconfig::native_odbc_drivers
set fixture_odbc [dict create status known names {}]
proc ::wizardconfig::odbc_drivers {} {return $::fixture_odbc}
load_fixture

test wizardconfig-1.1 {all configured families and both existing workloads} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    set found {}
    foreach db [dict get $metadata databases] {
        lappend found [dict get $db id]
        if {[lsort [dict keys [dict get $db workloads]]] ne {C H}} {error "Workload missing"}
    }
    lsort $found
} -result {db2 maria mssqls mysql ora pg vsql}

test wizardconfig-1.2 {preview never claims enhanced execution is enabled} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    list [dict get $metadata api_version] [dict get $metadata preview] [dict get $metadata custom_execution]
} -result {1 true false}

test wizardconfig-1.3 {only authoritative native configuration keys are emitted} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    foreach db [dict get $metadata databases] {
        set source ""
        dict for {key descriptor} $dbdict {
            if {[dict get $descriptor prefix] eq [dict get $db id]} {set source [set ::config$key]}
        }
        dict for {workload options} [dict get $db workloads] {
            foreach field [concat [dict get $options connection] [dict get $options settings]] {
                if {![dict exists $source [dict get $field group] [dict get $field name]]} {
                    error "Invented option: [dict get $field name]"
                }
            }
        }
    }
    return valid
} -result valid

test wizardconfig-1.4 {credentials are never serialized, even configured defaults} -setup {
    dict set configpostgresql tpcc pg_pass HIDDEN_SECRET_SENTINEL
    dict set configpostgresql tpcc pg_superuserpass HIDDEN_SECRET_SENTINEL
    dict set configmssqlserver connection mssqls_pass HIDDEN_SECRET_SENTINEL
    dict set configmysql connection mysql_ssl_key HIDDEN_SECRET_SENTINEL
} -body {
    set payload [wizardconfig::metadata]
    set defaults_safe 1
    foreach database [dict get [json::json2dict $payload] databases] {
        dict for {code options} [dict get $database workloads] {
            foreach field [dict get $options connection] {
                if {[dict exists $field secret] && [dict get $field secret] && [dict get $field default] ne ""} {
                    set defaults_safe 0
                }
            }
        }
    }
    list [string match *HIDDEN_SECRET_SENTINEL* $payload] $defaults_safe
} -cleanup {load_fixture} -result {0 1}

test wizardconfig-1.5 {field builder also rejects accidental secret descriptors} -body {
    wizardconfig::field $configpostgresql tpcc pg_pass username "Wrong" text
} -result {}

test wizardconfig-1.6 {PostgreSQL workload database names and XML defaults retained} -body {
    set options [dict get [database [json::json2dict [wizardconfig::metadata]] pg] workloads H]
    set field [field_by_name [dict get $options connection] pg_tpch_dbase]
    list [dict get $field group] [dict get $field role] [dict get $field default]
} -result {tpch database tpch}

test wizardconfig-1.7 {schema building VUs differ from generic driver virtual users} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    set options [dict get [database $metadata pg] workloads C]
    set field [field_by_name [dict get $options settings] pg_num_vu]
    list [dict get $field role] [dict get $field group] \
        [dict get $metadata generic virtual_users] [dict get $metadata generic avu_max]
} -result {builder_vu tpcc 1 null}

test wizardconfig-1.8 {generic defaults are read from current HammerDB configuration} -setup {
    dict set genericdict autopilot autopilot_sequence {1 3 6}
    dict set genericdict virtual_user_options virtual_users 3
} -body {
    set generic [dict get [json::json2dict [wizardconfig::metadata]] generic]
    list [dict get $generic virtual_users] [dict get $generic autopilot_sequence]
} -cleanup {load_fixture} -result {3 {1 3 6}}

test wizardconfig-1.9 {SQL Server platform-specific auth names and dependency} -body {
    set result {}
    foreach platform {unix windows} {
        set fields [json::json2dict [huddle jsondump \
            [wizardconfig::connection_fields mssqls $configmssqlserver tpcc $platform]]]
        set uid [field_by_name $fields mssqls_uid]
        lappend result [dict get $uid condition name] [dict get $uid condition values]
    }
    set result
} -result {mssqls_linux_authent sql mssqls_authentication sql}

test wizardconfig-1.10 {unconfigured or unsupported workload is not advertised} -setup {
    dict set dbdict postgresql workloads TPROC-C
    unset configdb2
} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    list [dict keys [dict get [database $metadata pg] workloads]] [llength [dict get $metadata databases]]
} -cleanup {load_fixture} -result {C 6}

test wizardconfig-1.11 {library failure remains unavailable without leaking diagnostics} -body {
    list [wizardconfig::native_library_status WizardLibraryThatMustNotExist] \
        [wizardconfig::native_library_status {Tcl 9.0}]
} -result {unavailable available}

test wizardconfig-1.12 {metadata request does not mutate configuration} -body {
    set before [list $dbdict $genericdict $configpostgresql $configmssqlserver]
    wizardconfig::metadata
    expr {$before eq [list $dbdict $genericdict $configpostgresql $configmssqlserver]}
} -result 1

test wizardconfig-1.13 {credential-bearing non-secret connection defaults are withheld} -setup {
    dict set configoracle connection instance system/HIDDEN_SECRET_SENTINEL@db.example/ORCL
    dict set configpostgresql connection pg_host postgresql://user:HIDDEN_SECRET_SENTINEL@db.example
    dict set configmssqlserver connection mssqls_linux_server {Server=db.example;PWD=HIDDEN_SECRET_SENTINEL}
    dict set configmssqlserver connection mssqls_linux_odbc {Driver=example;PWD=HIDDEN_SECRET_SENTINEL}
} -body {
    set payload [wizardconfig::metadata]
    set metadata [json::json2dict $payload]
    set oracle [dict get [database $metadata ora] workloads C connection]
    list [string match *HIDDEN_SECRET_SENTINEL* $payload] \
        [dict get [field_by_name $oracle instance] default]
} -cleanup {load_fixture} -result {0 {}}

test wizardconfig-2.1 {session and optional profile modes contain no invented profiles} -body {
    set generic [dict get [json::json2dict [wizardconfig::metadata]] generic]
    list [dict get $generic credential_modes] [dict get $generic credential_mode] [dict get $generic profiles]
} -result {{session profile} session {}}

test wizardconfig-2.2 {all seven engines expose blank session credentials for each workload} -body {
    set found {}
    foreach db [dict get [json::json2dict [wizardconfig::metadata]] databases] {
        dict for {workload options} [dict get $db workloads] {
            set passwords 0
            foreach field [dict get $options connection] {
                if {[dict exists $field secret] && [dict get $field secret]} {
                    if {[dict get $field type] ne "password" || [dict get $field default] ne ""} {error "Credential leaked"}
                    incr passwords
                }
            }
            if {$passwords == 0} {error "Missing session credential for [dict get $db id] $workload"}
            lappend found [dict get $db id]/$workload
        }
    }
    llength $found
} -result 14

test wizardconfig-2.3 {Oracle RAC retains native integer encodings} -body {
    set options [dict get [database [json::json2dict [wizardconfig::metadata]] ora] workloads C]
    set rac [field_by_name [dict get $options connection] rac]
    list [dict get $rac default] [dict get $rac true_value] [dict get $rac false_value]
} -result {false 1 0}

test wizardconfig-2.4 {all timed-only driver flags use actual driver dependencies} -body {
    foreach db [dict get [json::json2dict [wizardconfig::metadata]] databases] {
        set fields [dict get $db workloads C settings]
        set driver [dict get [field_by_name $fields [dict get $db id]_driver] name]
        foreach field $fields {
            if {[string match *allwarehouse [dict get $field name]] || [string match *timeprofile [dict get $field name]]} {
                if {[dict get $field condition name] ne $driver || [dict get $field condition values] ne "timed"} {
                    error "Incorrect timed-driver dependency"
                }
            }
        }
    }
    return valid
} -result valid

test wizardconfig-2.5 {async descendants require timed driver, keythink and async selection} -body {
    set db [database [json::json2dict [wizardconfig::metadata]] pg]
    set fields [dict get $db workloads C settings]
    set client [field_by_name $fields pg_async_client]
    lmap dependency [dict get $client conditions] {list [dict get $dependency name] [dict get $dependency values]}
} -result {{pg_driver timed} {pg_keyandthink true} {pg_async_scale true}}

test wizardconfig-2.6 {schema operations retain native PostgreSQL and Oracle admin context} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    set pg [dict get [database $metadata pg] workloads H connection]
    set ora [dict get [database $metadata ora] workloads C connection]
    list [dict get [field_by_name $pg pg_tpch_superuser] operations] \
        [dict get [field_by_name $pg pg_tpch_superuserpass] default] \
        [dict get [field_by_name $pg pg_tpch_defaultdbase] default] \
        [dict get [field_by_name $ora system_user] default] \
        [dict get [field_by_name $ora system_password] default]
} -result {{buildschema checkschema deleteschema} {} postgres system {}}

test wizardconfig-2.7 {TLS descriptors use platform CA paths and explicit inactive clearing} -body {
    set result {}
    foreach {prefix dbname} {mysql mysql maria mariadb vsql villagesql} {
        foreach platform {unix windows} {
            set fields [json::json2dict [huddle jsondump \
                [wizardconfig::connection_fields $prefix [set config$dbname] tpcc $platform]]]
            set suffix [expr {$platform eq "windows" ? "windows" : "linux"}]
            field_by_name $fields ${prefix}_ssl_${suffix}_capath
            set key [field_by_name $fields ${prefix}_ssl_key]
            if {[dict get $key default] ne "" || ![dict get $key path_reference] || [dict exists $key secret]} {error "Key path is not an empty path reference"}
            if {![dict get $key required] || [dict get $key inactive_value] ne ""} {error "Incorrect key requirements"}
            set clear [lmap condition [dict get $key clear_when] {list [dict get $condition name] [dict get $condition values]}]
            if {$clear ne [list [list ${prefix}_ssl true] [list ${prefix}_ssl_two_way false]]} {error "Incorrect one-way clearing"}
            lappend result $prefix/$platform
        }
    }
    llength $result
} -result 6

test wizardconfig-2.8 {TLS private key material is never emitted as a path default} -setup {
    dict set configmysql connection mysql_ssl_key "-----BEGIN PRIVATE KEY-----\nHIDDEN_SECRET_SENTINEL\n-----END PRIVATE KEY-----"
    dict set configmysql connection mysql_ssl_ca "-----BEGIN CERTIFICATE-----\nHIDDEN_SECRET_SENTINEL"
} -body {
    string match *HIDDEN_SECRET_SENTINEL* [wizardconfig::metadata]
} -cleanup {load_fixture} -result 0

test wizardconfig-2.9 {Entra and SQL credentials follow native Linux and Windows auth selections} -body {
    set result {}
    foreach platform {unix windows} {
        set fields [json::json2dict [huddle jsondump \
            [wizardconfig::connection_fields mssqls $configmssqlserver tpcc $platform]]]
        set auth [expr {$platform eq "windows" ? "mssqls_authentication" : "mssqls_linux_authent"}]
        set pass [field_by_name $fields mssqls_pass]
        set object [field_by_name $fields mssqls_msi_object_id]
        if {[dict get $pass condition name] ne $auth || [dict get $pass condition values] ne "sql"} {error "Wrong SQL password condition"}
        if {[dict get $object condition name] ne $auth || [dict get $object condition values] ne "entra"} {error "Wrong Entra condition"}
        field_by_name $fields mssqls_azure
        lappend result $platform
    }
    set result
} -result {unix windows}

test wizardconfig-2.10 {Db2 target is the workload alias, not the unrelated default alias} -body {
    set options [dict get [database [json::json2dict [wizardconfig::metadata]] db2] workloads C]
    set fields [dict get $options connection]
    set alias [field_by_name $fields db2_dbase]
    list [dict get $alias role] [dict get $alias default] [catch {field_by_name $fields db2_def_dbase}]
} -result {endpoint_database tpcc 1}

test wizardconfig-2.11 {ODBC adapter presence does not imply selected native driver is installed} -setup {
    set fixture_odbc [dict create status known names {}]
} -body {
    set db [database [json::json2dict [wizardconfig::metadata]] mssqls]
    list [dict get $db adapter_status] [dict get $db native_driver_status]
} -result {available unavailable}

test wizardconfig-2.12 {native ODBC enumeration identifies selected installed driver only} -setup {
    set fixture_odbc [dict create status known names [list {ODBC Driver 18 for SQL Server}]]
} -body {
    set metadata [json::json2dict [wizardconfig::metadata]]
    list [dict get [database $metadata mssqls] native_driver_status] [dict get $metadata installed_odbc_drivers]
} -cleanup {set fixture_odbc [dict create status known names {}]} \
    -result {available {{ODBC Driver 18 for SQL Server}}}

test wizardconfig-2.13 {unknown driver-enumeration evidence remains unverified} -setup {
    set fixture_odbc [dict create status unverified names {}]
} -body {
    dict get [database [json::json2dict [wizardconfig::metadata]] mssqls] native_driver_status
} -cleanup {set fixture_odbc [dict create status known names {}]} -result unverified

test wizardconfig-2.14 {query refresh dependencies and controls use real workload options} -body {
    set fields [dict get [database [json::json2dict [wizardconfig::metadata]] pg] workloads H settings]
    set count [field_by_name $fields pg_update_sets]
    list [dict get $count condition name] [dict get $count condition values] \
        [dict get [field_by_name $fields pg_degree_of_parallel] default]
} -result {pg_refresh_on true 2}

rename ::wizardconfig::library_status {}
rename ::wizardconfig::native_library_status ::wizardconfig::library_status
rename ::wizardconfig::odbc_drivers {}
rename ::wizardconfig::native_odbc_drivers ::wizardconfig::odbc_drivers
set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
